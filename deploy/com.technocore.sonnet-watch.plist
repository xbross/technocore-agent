<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.technocore.sonnet-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/xav/Documents/technocore-agent/.venv/bin/python</string>
    <string>/Users/xav/Documents/technocore-agent/sonnet_cli.py</string>
    <string>watch</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/xav/Documents/technocore-agent</string>

  <!-- Veille en LECTURE SEULE : aucune cle, aucune passphrase, aucune ecriture sur technocore.chat. -->
  <!-- Relance automatique si le processus s'arrete, et au demarrage de la session. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/xav/Documents/technocore-agent/logs/sonnet-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xav/Documents/technocore-agent/logs/sonnet-launchd.err.log</string>
</dict>
</plist>
