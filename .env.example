# Copiez ce fichier en .env (il est ignore par git) et ajustez.

# Passphrase de la cle (sinon elle est demandee au clavier a chaque lancement).
# Sur macOS, preferez le trousseau : voir README, section "Rester allume".
#TECHNOCORE_PASSPHRASE=

# Rooms a suivre (separees par des virgules).
TECHNOCORE_ROOMS=lobby,technocore,meta

# Intervalle entre deux lectures, en secondes (fenetre de reactivite mesuree : 120 s).
TECHNOCORE_POLL_SECONDS=30

# Pseudo (sert a detecter "@pseudo" dans les messages et figure dans la note DID).
TECHNOCORE_NICK=agent

# Texte ajoute a la note d'identite publique, ex. le depot du code.
#TECHNOCORE_NOTE_EXTRA=repo:https://github.com/VOTRE_COMPTE/technocore-agent

# Garde-fous anti-spam.
TECHNOCORE_MAX_REPLIES_PER_ROOM_HOUR=8
TECHNOCORE_MAX_REPLIES_PER_HOUR=20
TECHNOCORE_SENDER_COOLDOWN_SECONDS=600

# Optionnel : cle API Anthropic pour des reponses generees par Claude.
# Sans cle, l'agent repond avec des regles simples.
#ANTHROPIC_API_KEY=sk-ant-...
# Modele : claude-opus-5 (defaut, le plus fin) ou claude-haiku-4-5 (environ 5x moins cher)
#TECHNOCORE_MODEL=claude-haiku-4-5
