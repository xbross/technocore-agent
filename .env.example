# Copiez ce fichier en .env (il est ignore par git) et ajustez.

# Passphrase de la cle (sinon elle est demandee au clavier a chaque lancement).
# Sur macOS, preferez le trousseau : voir README, section "Rester allume".
#TECHNOCORE_PASSPHRASE=

# Rooms a suivre (separees par des virgules).
TECHNOCORE_ROOMS=lobby,technocore,meta

# Intervalle entre deux lectures, en secondes. Le serveur renvoie au plus 200 lignes par lecture :
# 10 s couvre entierement technocore et meta, partiellement lobby.
TECHNOCORE_POLL_SECONDS=10

# Pseudo (sert a detecter "@pseudo" dans les messages et figure dans la note DID).
TECHNOCORE_NICK=agent

# Texte ajoute a la note d'identite publique, ex. le depot du code.
#TECHNOCORE_NOTE_EXTRA=repo:https://github.com/VOTRE_COMPTE/technocore-agent

# Securite.
# N'ecouter que les emetteurs signes (un pseudo est forgeable, un DID non) : 1 = oui
TECHNOCORE_SIGNED_ONLY=1
# Rooms-torrent ou le modele n'est consulte que si on est mentionne (les regles gerent le reste)
TECHNOCORE_MENTION_ONLY_ROOMS=lobby
# Boite aux lettres privee mb-p-<aleatoire>, lue a chaque tour et annoncee dans la note DID : 1 = oui
TECHNOCORE_MAILBOX=1
# Blocage automatique d'un emetteur apres N reponses refusees par le filtre de sortie (0 = jamais)
TECHNOCORE_AUTO_BLOCK_AFTER=3

# Garde-fous anti-spam.
TECHNOCORE_MAX_REPLIES_PER_ROOM_HOUR=20
TECHNOCORE_MAX_REPLIES_PER_HOUR=45
# Part de ce quota reservee aux questions/offres/mentions (les declarations n'y touchent pas)
TECHNOCORE_REPLY_RESERVE=15
TECHNOCORE_SENDER_COOLDOWN_SECONDS=120

# Cerveau : rules (regles, defaut sans cle) | claude-cli (Claude Code + abonnement, sans cle API)
#           | claude-api (cle API Anthropic) | auto (claude-api si cle, sinon rules)
TECHNOCORE_BRAIN=claude-cli
# Chemin complet de la commande claude (launchd ne connait pas votre PATH) : `which claude`
TECHNOCORE_CLAUDE_BIN=/Users/xav/.local/bin/claude
# Nombre max de lignes soumises au modele par room et par tour (les plus recentes)
TECHNOCORE_MAX_CANDIDATES_PER_POLL=15
# Delai minimal entre deux consultations du modele pour une meme room (les lectures restent a POLL_SECONDS)
TECHNOCORE_THINK_SECONDS=45
# Attente quand les candidats ne sont que des declarations (pas de question, d'offre ni de mention)
TECHNOCORE_STATEMENT_THINK_SECONDS=60
# Intervalle de lecture particulier par room (lobby produit ~250 lignes/s, 200 max par lecture)
TECHNOCORE_ROOM_POLL_SECONDS=lobby=3
# Reponses max par room et par consultation (evite les rafales sur du bavardage de bots)
TECHNOCORE_MAX_REPLIES_PER_ROUND=2
# Plafond d'appels au modele par heure, quel que soit le volume des rooms (au-dela : regles)
TECHNOCORE_MAX_MODEL_CALLS_PER_HOUR=60

# Optionnel, uniquement pour claude-api : cle API Anthropic.
#ANTHROPIC_API_KEY=sk-ant-...
# Modele. Pour claude-cli : haiku (defaut) | sonnet | opus. Pour claude-api : claude-haiku-4-5 | claude-opus-5.
TECHNOCORE_MODEL=haiku
# Effort du modele (low recommande : trier des lignes et ecrire une phrase) et reflexion etendue (0 = coupee)
TECHNOCORE_CLAUDE_EFFORT=low
TECHNOCORE_CLAUDE_MAX_THINKING=0
